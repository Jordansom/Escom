package clases;
    public static String transformarCadena(String cadena) {
        StringBuilder cadenaTransformada = new StringBuilder();
    
        for (int i = 0; i < cadena.length(); i++) {
            char caracter = cadena.charAt(i);
    
            if (Character.isDigit(caracter) && (i == 0 || !Character.isDigit(cadena.charAt(i - 1)))) {
                cadenaTransformada.append("i");
            } else {
                cadenaTransformada.append(caracter);
            }
        }
    }